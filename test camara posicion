#  UTILIDADES
# ═══════════════════════════════════════════════════════════════
def wrap_angle(a: float) -> float:
    while a <= -math.pi: a += 2 * math.pi
    while a > math.pi:   a -= 2 * math.pi
    return a


def ask_float(prompt: str, default: float, min_val: float = None, max_val: float = None) -> float:
    while True:
        try:
            raw = input(f"  {prompt} [default: {default}]: ").strip()
            val = float(raw) if raw else default
            if min_val is not None and val < min_val:
                print(f"    ✘ Valor mínimo: {min_val}")
                continue
            if max_val is not None and val > max_val:
                print(f"    ✘ Valor máximo: {max_val}")
                continue
            return val
        except ValueError:
            print("    ✘ Introduce un número válido")
        except KeyboardInterrupt:
            print("\n\nSetup cancelado por usuario")
            sys.exit(0)


def ask_int(prompt: str, default: int, min_val: int = None, max_val: int = None) -> int:
    while True:
        try:
            raw = input(f"  {prompt} [default: {default}]: ").strip()
            val = int(raw) if raw else default
            if min_val is not None and val < min_val:
                print(f"    ✘ Valor mínimo: {min_val}")
                continue
            if max_val is not None and val > max_val:
                print(f"    ✘ Valor máximo: {max_val}")
                continue
            return val
        except ValueError:
            print("    ✘ Introduce un número entero válido")
        except KeyboardInterrupt:
            print("\n\nSetup cancelado por usuario")
            sys.exit(0)


def ask_yn(prompt: str, default: bool = True) -> bool:
    default_str = "s" if default else "n"
    while True:
        try:
            raw = input(f"  {prompt} (s/n) [default: {default_str}]: ").strip().lower()
            if raw == "":
                return default
            if raw in ("s", "si", "y", "yes"):
                return True
            if raw in ("n", "no"):
                return False
            print("    ✘ Responde s o n")
        except KeyboardInterrupt:
            print("\n\nSetup cancelado por usuario")
            sys.exit(0)


# ═══════════════════════════════════════════════════════════════
#  SETUP INTERACTIVO
# ═══════════════════════════════════════════════════════════════
def setup_interactivo() -> tuple[Config, str, float, float, float, float]:
    """
    Pregunta todos los parámetros necesarios por consola.
    Devuelve (cfg, modo, target_x, target_y, duration, position_tolerance)
    """
    print("\n" + "═" * 65)
    print("  SETUP — CÁMARA + BNO055 + ODRIVE  (sin MPU6050)")
    print("═" * 65)

    cfg = Config()
    # Parámetros fijos (hardware conocido — no se preguntan)
    cfg.bno_addr         = 0x28
    cfg.node_right       = 1
    cfg.node_left        = 2
    cfg.wheel_radius     = 0.08
    cfg.wheelbase        = 0.30
    cfg.max_linear_speed = 0.5

    # ── Marcas del patrón ──────────────────────────────────────
    print("\n  [1/3] DIMENSIONES DEL PATRÓN DE MARCAS VERDES")
    print("        (mide la distancia entre los centros de las marcas)")
    cfg.mark_width_cm  = ask_float("Anchura del patrón (cm, eje horizontal)", 6.0,  min_val=0.5)
    cfg.mark_height_cm = ask_float("Altura del patrón  (cm, eje vertical)",  10.0, min_val=0.5)

    # ── Calibración cámara ────────────────────────────────────
    print("\n  [2/3] CALIBRACIÓN DE CÁMARA")
    print("        La calibración por defecto es para la Picamera2 IMX219 a 1280×720.")
    cfg.use_default_calibration = ask_yn("¿Usar calibración por defecto?", default=True)

    if not cfg.use_default_calibration:
        print("        Introduce los parámetros de tu calibración:")
        fx = ask_float("fx (focal length x, px)", 1827.98, min_val=100.0)
        fy = ask_float("fy (focal length y, px)", 1825.04, min_val=100.0)
        cx = ask_float("cx (principal point x, px)", 572.34, min_val=0.0)
        cy = ask_float("cy (principal point y, px)", 362.60, min_val=0.0)
        cfg._custom_fx = fx
        cfg._custom_fy = fy
        cfg._custom_cx = cx
        cfg._custom_cy = cy

    # ── Modo de operación ─────────────────────────────────────
    print("\n  [3/3] MODO DE OPERACIÓN")
    print("        1 - Solo cámara (sin ODrive): ver detección y estimación de posición")
    print("        2 - Cámara + ODrive: movimiento libre con visualización")
    print("        3 - Ir a posición XY: navegar a coordenadas respecto a la torre")
    while True:
        try:
            modo_raw = input("  Selecciona modo [1-3]: ").strip()
            if modo_raw in ("1", "2", "3"):
                break
            print("    ✘ Elige 1, 2 o 3")
        except KeyboardInterrupt:
            print("\n\nSetup cancelado por usuario")
            sys.exit(0)

    modo_map = {"1": "solo_camara", "2": "camara_odrive", "3": "goto_position"}
    modo = modo_map[modo_raw]

    target_x = target_y = 0.0
    if modo == "goto_position":
        print("\n  [3b] POSICIÓN OBJETIVO (respecto a la torre en x=0, y=0)")
        target_x = ask_float("Coordenada X objetivo (m, Este +)",  2.0)
        target_y = ask_float("Coordenada Y objetivo (m, Norte +)", 5.0)
        cfg.position_tolerance = ask_float("Tolerancia de llegada (m)", 0.10, min_val=0.02)

    # ── Duración ──────────────────────────────────────────────
    print("\n  [3c] DURACIÓN DEL TEST")
    duration = ask_float("Duración (segundos)", 120.0, min_val=5.0)

    # ── Resumen ───────────────────────────────────────────────
    print("\n" + "─" * 65)
    print("  RESUMEN DE CONFIGURACIÓN")
    print("─" * 65)
    print(f"  Patrón marcas:   {cfg.mark_width_cm:.1f} cm × {cfg.mark_height_cm:.1f} cm")
    print(f"  Calibración:     {'por defecto' if cfg.use_default_calibration else 'personalizada'}")
    print(f"  Modo:            {modo}")
    if modo == "goto_position":
        print(f"  Objetivo XY:     ({target_x:.2f}, {target_y:.2f}) m  tol={cfg.position_tolerance:.2f}m")
    print(f"  Duración:        {duration:.0f}s")
    print("─" * 65)

    if not ask_yn("¿Confirmar y continuar?", default=True):
        print("  Reiniciando setup...")
        return setup_interactivo()

    return cfg, modo, target_x, target_y, duration


