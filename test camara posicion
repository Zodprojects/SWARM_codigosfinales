# ═══════════════════════════════════════════════════════════════
#  CONFIGURACIÓN (se rellena en el setup interactivo)
# ═══════════════════════════════════════════════════════════════
@dataclass
class Config:
    # ── Torre ──
    tower_height: float = 3.0

    # ── CAN / ODrive ──
    can_channel:       str   = "can0"
    can_bitrate:       int   = 500_000
    node_right:        int   = 1
    node_left:         int   = 2
    wheel_radius:      float = 0.08
    gear_ratio:        float = 1.0
    wheelbase:         float = 0.30
    vmax_rev_s_clip:   float = 20.0
    sign_R:            float = +1.0
    sign_L:            float = +1.0
    max_linear_speed:  float = 0.5
    max_angular_speed: float = 1.0

    # ── BNO055 ──
    bno_addr: int = 0x28   # 0x28 o 0x29 según pin ADR

    # ── Marcas verdes (se piden por consola) ──
    mark_width_cm:  float = 6.0    # distancia horizontal entre marcas (cm)
    mark_height_cm: float = 10.0   # distancia vertical entre marcas (cm)

    # ── Umbral de brillo para rayo centrado ──
    brightness_threshold: int = 200

    # ── Tolerancia de llegada (m) ──
    position_tolerance: float = 0.10

    # ── Calibración cámara (se puede sustituir por consola) ──
    use_default_calibration: bool = True
    # Si use_default_calibration=False se pedirán fx, fy, cx, cy por consola


