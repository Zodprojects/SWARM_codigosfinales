#  ODOMETRÍA
# ═══════════════════════════════════════════════════════════════
class WheelOdometry:
    def __init__(self, cfg: Config, x0=0.0, y0=0.0, psi0=0.0):
        self.cfg = cfg
        self.x = x0
        self.y = y0
        self.psi = psi0
        self._t = time.time()
        print("  ✔ Odometría por encoders inicializada")

    def reset(self, x=0.0, y=0.0, psi=0.0):
        self.x, self.y, self.psi = x, y, psi
        self._t = time.time()

    def update(self, vR: float, vL: float):
        now = time.time()
        dt = now - self._t
        if dt <= 0 or dt > 0.5:
            self._t = now
            return
        v     = (vR + vL) / 2.0
        omega = (vR - vL) / self.cfg.wheelbase
        self.x   += v * math.sin(self.psi) * dt
        self.y   += v * math.cos(self.psi) * dt
        self.psi  = wrap_angle(self.psi + omega * dt)
        self._t   = now

    def get_pose(self):
        return self.x, self.y, self.psi


