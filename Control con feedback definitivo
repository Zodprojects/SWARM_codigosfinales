# -*- coding: utf-8 -*-
"""
Actuador lineal por CAN (dir/PWM) con opción de:
  - "seq": secuencia fija de (dir, pwm, dur)
  - "angle_pid": control de ángulo con MPU6050 (pitch/roll) como feedback

Requisitos:
  pip install python-can smbus2 adafruit-circuitpython-bno055
  Configurar can0 (p.ej., 500 kbps).
"""

from __future__ import annotations
import time, math, sys
from dataclasses import dataclass
from smbus2 import SMBus

# ======================= CONFIGURACIÓN =======================
@dataclass
class Config:
    # --- CAN ---
    can_channel: str = "can0"
    can_bitrate: int = 500_000

    # --- Actuador (IDs fuera de bandas ODrive) ---
    ACT_CAN_ID_CMD:  int = 0x321
    ACT_CAN_ID_DATA: int = 0x322
    act_refresh_s: float = 0.060

    # --- Modo: "seq" o "angle_pid" ---
    act_mode: str = "angle_pid"

    # --- Secuencia (solo en "seq") ---
    actuador_seq = [
        (1, 120, 1.5),
        ("wait", 0, 1.0),
        (2, 140, 1.5),
    ]

    # --- Control por ángulo (angle_pid) ---
    theta_ref_deg: float = 30.0          # Consigna (grados)
    imu_axis: str = "roll"               # Usa solo ROLL
    imu_sign: float = +1.0               # +1 normal, -1 si está invertido
    imu_dt: float = 0.05                 # Período de muestreo (20 Hz)
    imu_alpha: float = 0.98              # Filtro complementario (0.95-0.99)
    
    # --- PID Estándar ---
    Kp: float = 1.0      # Ganancia proporcional
    Ki: float = 0.0      # Ganancia integral
    Kd: float = 0.0      # Ganancia derivada
    I_clamp: float = 0.6 # Límite de integral anti-windup
    
    # --- PWM ---
    deadband_deg: float = 1.0        # No mover si |error| < esto
    PWM_MIN_EFF: int = 85            # PWM mínimo para vencer fricción
    PWM_MAX: int = 255               # PWM máximo
    PWM_SLEW: int = 25               # Cambio máximo de PWM por ciclo (suave)
    pwm_per_degree: float = 12.0     # PWM adicional por grado de error
    
    # --- Seguridad ---
    theta_min_deg: float = 0.0
    theta_max_deg: float = 60.0
    
    # --- Telemetría ---
    telemetry_hz: float = 5.0        # Frecuencia de impresión
    
    # --- Duración ---
    run_seconds: float | None = None  # None = hasta Ctrl+C

# ======================= CAN =======================
class CanManager:
    def __init__(self, cfg: Config):
        import can
        self.bus = can.interface.Bus(channel=cfg.can_channel, bustype="socketcan")
    def send(self, arbitration_id: int, data: list[int]):
        import can
        msg = can.Message(arbitration_id=arbitration_id, data=data, is_extended_id=False)
        self.bus.send(msg)
    def shutdown(self):
        try: self.bus.shutdown()
        except Exception: pass

# ======================= Actuador (dir/PWM) =======================
class ActuadorDPWM:
    """TX: arbitration_id=cfg.ACT_CAN_ID_CMD, data=[dir, pwm]. Paro: [0,0]."""
    def __init__(self, cfg: Config, can_mgr: CanManager):
        self.cfg = cfg
        self.can = can_mgr
        self._pwm_last = 0
    def send(self, direccion: int, pwm: int):
        direccion = int(direccion) & 0xFF
        pwm = int(pwm) & 0xFF
        self.can.send(self.cfg.ACT_CAN_ID_CMD, [direccion, pwm])
    def stop(self):
        try: self.send(0, 0)
        except: pass
        self._pwm_last = 0
    def enviar_comando(self, direccion: int, pwm: int, duracion: float):
        t_end = time.perf_counter() + max(0.0, float(duracion))
        while time.perf_counter() < t_end:
            self.send(direccion, pwm)
            print(f"🟢 Actuador → dir:{direccion} pwm:{pwm}")
            time.sleep(self.cfg.act_refresh_s)
        self.stop()
        print("🛑 Actuador detenido.")

# ======================= IMUs =======================
# ---- MPU6050 (pitch/roll con filtro complementario) ----
PWR_MGMT_1 = 0x6B
ACCEL_XOUT_H = 0x3B
GYRO_XOUT_H  = 0x43
ACCEL_SCALE = 16384.0  # LSB/g
GYRO_SCALE  = 131.0    # LSB/(°/s)

# ---- Direcciones del actuador ----
DIR_EXTIENDE = 2  # Aumenta ángulo (roll)
DIR_RETRAE = 1    # Disminuye ángulo (roll)

class MPU6050:
    def __init__(self, bus=1, addr=MPU_ADDR, dt=0.02, alpha=0.98):
        self.bus = SMBus(bus)
        self.addr = addr
        self.dt = dt
        self.alpha = alpha
        self.bus.write_byte_data(self.addr, PWR_MGMT_1, 0x00)
        time.sleep(0.05)
        self.gyro_bias = self._calibrate_gyro()
        ax, ay, az, *_ = self._read_accel_gyro()
        self.pitch, self.roll = self._accel_to_angles(ax, ay, az)

    def _read_word(self, reg):
        hi = self.bus.read_byte_data(self.addr, reg)
        lo = self.bus.read_byte_data(self.addr, reg+1)
        val = (hi << 8) | lo
        if val >= 0x8000: val = -((65535 - val) + 1)
        return val

    def _read_accel_gyro(self):
        ax = self._read_word(ACCEL_XOUT_H)     / ACCEL_SCALE
        ay = self._read_word(ACCEL_XOUT_H+2)   / ACCEL_SCALE
        az = self._read_word(ACCEL_XOUT_H+4)   / ACCEL_SCALE
        gx = self._read_word(GYRO_XOUT_H)      / GYRO_SCALE
        gy = self._read_word(GYRO_XOUT_H+2)    / GYRO_SCALE
        gz = self._read_word(GYRO_XOUT_H+4)    / GYRO_SCALE
        return ax, ay, az, gx, gy, gz

    def _accel_to_angles(self, ax, ay, az):
        roll  = math.degrees(math.atan2(ay, az))
        pitch = math.degrees(math.atan2(-ax, math.sqrt(ay*ay + az*az)))
        return pitch, roll

    def _calibrate_gyro(self, samples=200):
        sx = sy = sz = 0.0
        for _ in range(samples):
            _, _, _, gx, gy, gz = self._read_accel_gyro()
            sx += gx; sy += gy; sz += gz
            time.sleep(0.002)
        return {'x': sx/samples, 'y': sy/samples, 'z': sz/samples}

    def read_pitch_roll(self):
        ax, ay, az, gx, gy, gz = self._read_accel_gyro()
        gx -= self.gyro_bias['x']; gy -= self.gyro_bias['y']
        pitch_gyro = self.pitch + gy * self.dt
        roll_gyro  = self.roll  + gx * self.dt
        pitch_acc, roll_acc = self._accel_to_angles(ax, ay, az)
        self.pitch = self.alpha * pitch_gyro + (1 - self.alpha) * pitch_acc
        self.roll  = self.alpha * roll_gyro  + (1 - self.alpha) * roll_acc
        return self.pitch, self.roll

# ======================= Control por Ángulo =======================
class AnglePIDActuator:
    def __init__(self, cfg: Config, act: ActuadorDPWM):
        self.cfg = cfg
        self.act = act
        self.mpu = MPU6050(dt=cfg.imu_dt, alpha=cfg.imu_alpha)
        self._ei = 0.0      # Integral del error
        self._e_prev = 0.0  # Error anterior (para derivada)
        self._pwm_prev = 0  # PWM anterior (para slew-rate)

    def _pid(self, e, dt):
        """Calcula la acción PID: u = Kp*e + Ki*ei + Kd*de"""
        # Integral con anti-windup
        self._ei += e * dt
        self._ei = max(-self.cfg.I_clamp, min(self.cfg.I_clamp, self._ei))
        
        # Derivada
        de = (e - self._e_prev) / max(1e-3, dt)
        self._e_prev = e
        
        # Salida PID
        u = self.cfg.Kp * e + self.cfg.Ki * self._ei + self.cfg.Kd * de
        return u

    def _pwm_from_u(self, u):
        """Convierte acción PID (grados) a PWM con deadband y slew-rate"""
        mag = abs(u)
        
        # Deadband: no mover si el error es muy pequeño
        if mag < self.cfg.deadband_deg:
            pwm = 0
        else:
            # Mapeo lineal: pwm = PWM_MIN_EFF + pwm_per_degree * error_en_grados
            pwm = int(self.cfg.PWM_MIN_EFF + self.cfg.pwm_per_degree * mag)
            pwm = min(self.cfg.PWM_MAX, pwm)
        
        # Slew-rate: limita cambio de PWM por ciclo
        dp = max(-self.cfg.PWM_SLEW, min(self.cfg.PWM_SLEW, pwm - self._pwm_prev))
        pwm = self._pwm_prev + dp
        self._pwm_prev = pwm
        
        return max(0, pwm)

    def _dir_from_u(self, u):
        """Determina dirección basada en signo de u
        
        u > 0  → Necesita EXTENDER (aumentar roll) → DIR 2
        u < 0  → Necesita RETRAER (disminuir roll) → DIR 1
        """
        return DIR_EXTIENDE if u > 0 else DIR_RETRAE

    def _print_status(self, theta_ref, theta_med, e, pwm, direccion):
        """Imprime estado de control en una línea"""
        if pwm == 0:
            dirstr = "STOP"
        else:
            dirstr = "DIR1" if direccion == 1 else "DIR2"
        
        line = (f"Ref={theta_ref:6.1f}°  Medido={theta_med:6.2f}°  "
                f"Error={e:6.2f}°  PWM={pwm:3d}  {dirstr}")
        sys.stdout.write("\r" + line + " " * 10)
        sys.stdout.flush()

    def run(self, max_seconds: float | None = None):
        print("▶️ Control PID de ángulo activo (MPU6050).")
        print(f"   Consigna: {self.cfg.theta_ref_deg}°")
        print(f"   Eje: {self.cfg.imu_axis}")
        print(f"   Kp={self.cfg.Kp}, Ki={self.cfg.Ki}, Kd={self.cfg.Kd}")
        print(f"   PWM_MIN={self.cfg.PWM_MIN_EFF}, PWM_MAX={self.cfg.PWM_MAX}")
        print(f"   Presiona Ctrl+C para parar.\n")
        
        dt = self.cfg.imu_dt
        t_start = time.perf_counter()
        t_telemetry = 0.0
        
        try:
            while True:
                # Chequeo de timeout
                if max_seconds is not None and (time.perf_counter() - t_start) >= max_seconds:
                    print("\n⏹️ Tiempo máximo alcanzado.")
                    break

                t0 = time.perf_counter()
                
                # Lee ángulos del MPU6050
                pitch, roll = self.mpu.read_pitch_roll()
                
                # Usa solo ROLL
                theta_med = roll * self.cfg.imu_sign
                
                # Límites de seguridad
                if theta_med < self.cfg.theta_min_deg or theta_med > self.cfg.theta_max_deg:
                    print(f"\n⛔ Ángulo fuera de rango: {theta_med:.1f}°. Paro.")
                    self.act.stop()
                    break

                # Cálculo del error y acción de control
                e = self.cfg.theta_ref_deg - theta_med
                u = self._pid(e, dt)
                
                # Conversión a PWM y dirección
                pwm = self._pwm_from_u(u)
                if pwm == 0:
                    self.act.stop()
                    direccion = 0
                else:
                    direccion = self._dir_from_u(u)
                    self.act.send(direccion, pwm)
                
                # Telemetría
                now = time.perf_counter()
                if now - t_telemetry >= (1.0 / max(1.0, self.cfg.telemetry_hz)):
                    self._print_status(self.cfg.theta_ref_deg, theta_med, e, pwm, direccion)
                    t_telemetry = now

                # Mantiene el período de muestreo
                t_spent = time.perf_counter() - t0
                time.sleep(max(0.0, dt - t_spent))
                
        except KeyboardInterrupt:
            print("\n⛔ Control interrumpido por usuario.")
        except Exception as e:
            print(f"\n❌ Error: {e}")
        finally:
            self.act.stop()
            print("\n✅ Parado.")

# ======================= MAIN =======================
def main():
    cfg = Config()
    canm = CanManager(cfg)
    act  = ActuadorDPWM(cfg, canm)
    print(f"▶️ Modo actuador: {cfg.act_mode}. Ctrl-C para parar.")
    try:
        if cfg.act_mode.lower() == "seq":
            for paso in cfg.actuador_seq:
                if isinstance(paso[0], str) and paso[0].lower() == "wait":
                    _, _, t_wait = paso
                    print(f"\n⏸️ Espera {t_wait:.2f}s")
                    time.sleep(max(0.0, float(t_wait)))
                    continue
                direccion, pwm, dur = paso
                act.enviar_comando(int(direccion), int(pwm), float(dur))
            act.stop()
        else:
            controller = AnglePIDActuator(cfg, act)
            controller.run(cfg.run_seconds)
    except KeyboardInterrupt:
        print("\n⛔ Interrupción usuario")
    except Exception as e:
        print("❌ FAULT:", e)
    finally:
        print("\n🛑 Parando…")
        try: act.stop()
        except: pass
        try: canm.shutdown()
        except: pass
        print("✅ Listo.")

if __name__ == "__main__":
    main()
